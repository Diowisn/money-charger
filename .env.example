# Salin ke .env.local (lokal) dan isi juga di Vercel > Settings > Environment Variables.

# Login memakai akun (email/password). Data lama otomatis menjadi milik akun pertama.
# OAuth hanya muncul bila kredensial provider tersedia. Facebook memakai
# FACEBOOK_APP_ID/FACEBOOK_APP_SECRET, atau META_APP_ID/WA_APP_SECRET bila memakai app Meta yang sama.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
FACEBOOK_APP_ID=YOUR_FACEBOOK_APP_ID
FACEBOOK_APP_SECRET=YOUR_FACEBOOK_APP_SECRET
# Opsional. Bila kosong, memakai origin request; APP_BASE_URL dipakai sebagai cadangan.
AUTH_CALLBACK_BASE_URL=
# Daftarkan callback: <origin>/api/auth/oauth/google/callback dan <origin>/api/auth/oauth/facebook/callback.

# Neon Postgres (pakai connection string "pooled" dari dashboard Neon)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# WhatsApp Cloud API (Meta)
WA_PHONE_NUMBER_ID=GANTI_DENGAN_PHONE_NUMBER_ID_DARI_META
WA_ACCESS_TOKEN=GANTI_DENGAN_TOKEN_PRODUKSI_META
WA_APP_SECRET=GANTI_DENGAN_APP_SECRET_META
WA_VERIFY_TOKEN=GANTI_DENGAN_STRING_ACAK_PANJANG_YANG_SAMA_DI_WEBHOOK
WA_API_VERSION=v25.0        # sesuaikan dengan versi Graph API yang tampil di Meta

# Opsional, hanya dipakai `npm run check:wa`
META_APP_ID=GANTI_DENGAN_APP_ID
WA_BUSINESS_ACCOUNT_ID=GANTI_DENGAN_WABA_ID

# Nomor pribadi pemilik (format baku tanpa plus), pisahkan koma bila lebih dari satu
ALLOWED_NUMBERS=6281234567890 # contoh dummy; ganti dengan nomor Anda

# Groq (cadangan bahasa bebas + baca foto struk). Aktifkan Zero Data Retention di akun Groq
# SEBELUM memakai key ini. Key yang sama dipakai untuk teks (GROQ_MODEL) dan foto (GROQ_VISION_MODEL).
GROQ_API_KEY=GANTI_DENGAN_API_KEY_GROQ
GROQ_MODEL=openai/gpt-oss-20b
# Opsional: model Groq cadangan, dipisahkan koma; dicoba bila model utama 404/5xx.
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b
# Model vision untuk membaca foto struk/transaksi; kosongkan untuk pakai default
# qwen/qwen3.8-27b (Llama 4 Scout tidak tersedia di akun Groq gratis saat uji).
GROQ_VISION_MODEL=
# Model untuk tab "Asisten" di dashboard (tanya jawab keuangan); kosongkan untuk memakai GROQ_MODEL.
GROQ_INSIGHT_MODEL=

# URL publik deployment, dipakai untuk tautan unduh ekspor CSV
APP_BASE_URL=https://nama-proyek-anda.vercel.app

# Opsional. Bila diisi, detail /api/health hanya bisa dibuka dengan header
# X-Health-Token atau Authorization: Bearer <nilai ini>. Tanpa ini endpoint hanya
# mengembalikan { ok, waktu } agar tidak membocorkan env/host/jumlah data.
HEALTH_TOKEN=

# Opsional: aktifkan /api/email/inbound untuk mencatat email transaksi (mis. BSI) otomatis.
# Isi dengan string acak panjang; kirim HANYA lewat header X-Email-Secret dari penyedia
# forwarding email (Google Apps Script, Resend Inbound, Cloudflare Email Workers, dll).
EMAIL_INBOUND_SECRET=
# Opsional: batasi pengirim email. Pisahkan koma. Contoh: banksi.co.id
EMAIL_ALLOWED_SENDERS=

# Kunci endpoint /api/cron/outbox untuk memproses antrean pesan masuk dan balasan WhatsApp.
# Jadwalkan POST berkala dengan Authorization: Bearer <nilai ini>.
CRON_SECRET=
